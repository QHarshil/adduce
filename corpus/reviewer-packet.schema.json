{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/QHarshil/adduce/blob/main/corpus/reviewer-packet.schema.json",
  "title": "Adduce corpus reviewer packet manifest",
  "description": "Manifest of one derived, role-scoped reviewer packet. A packet holds only the material one blinded reviewer needs: the reviewer documents, the frozen claim record, the two schemas, an empty review scaffold and a verification wrapper. It never carries another reviewer's file, a merged review, an adjudication, Adduce claim-link output, a candidate aggregate result or a coordinator answer summary, and the manifest is not listed among its own files.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "packet_schema_version",
    "packet_id",
    "reviewer_id",
    "created_at",
    "source_commit",
    "claim_ground_truth_sha256",
    "corpus_inventory_sha256",
    "candidate_pair",
    "review_scaffold_sha256",
    "clone_root",
    "repositories",
    "files",
    "excluded_material_classes"
  ],
  "properties": {
    "packet_schema_version": {"const": 1},
    "packet_id": {
      "type": "string",
      "pattern": "^packet-[0-9a-f]{32}$",
      "description": "Digest of the manifest body without this field, so the identity is recomputable and changes only when the packet or its creation time changes."
    },
    "reviewer_id": {"$ref": "#/$defs/identifier"},
    "created_at": {"$ref": "#/$defs/timestamp"},
    "source_commit": {
      "oneOf": [
        {"type": "null"},
        {"$ref": "#/$defs/commit"}
      ],
      "description": "Commit of the repository that built the packet, or null when the build tree is not a git repository. Never a substitute value."
    },
    "claim_ground_truth_sha256": {"$ref": "#/$defs/sha256"},
    "corpus_inventory_sha256": {"$ref": "#/$defs/sha256"},
    "candidate_pair": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/identifier"}
    },
    "review_scaffold_sha256": {"$ref": "#/$defs/sha256"},
    "clone_root": {
      "type": "string",
      "minLength": 1,
      "description": "Shared read-only clone root, as a repository-relative POSIX path when the root is inside the repository."
    },
    "repositories": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/repositoryBinding"}
    },
    "files": {
      "type": "array",
      "minItems": 7,
      "maxItems": 7,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/packetFile"}
    },
    "excluded_material_classes": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/excludedMaterialClass"}
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "timestamp": {"type": "string", "format": "date-time"},
    "packetPath": {
      "enum": [
        "PACKET_MANIFEST.json",
        "REVIEWER_GUIDE.md",
        "REVIEWER_CHECKLIST.md",
        "claim-review.schema.json",
        "pilot-claims.json",
        "review-scaffold.json",
        "reviewer-workspace.schema.json",
        "verify_packet.py"
      ]
    },
    "role": {
      "enum": [
        "reviewer_guide",
        "reviewer_checklist",
        "claim_ground_truth",
        "claim_review_schema",
        "reviewer_workspace_schema",
        "review_scaffold",
        "verify_wrapper"
      ]
    },
    "excludedMaterialClass": {
      "enum": [
        "peer_review",
        "merged_review",
        "adjudication",
        "adduce_claim_link_output",
        "candidate_aggregate_results",
        "coordinator_answer_summary"
      ]
    },
    "repositoryBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository_id",
        "expected_commit",
        "resolved_commit",
        "read_only_expected"
      ],
      "properties": {
        "repository_id": {"$ref": "#/$defs/identifier"},
        "expected_commit": {"$ref": "#/$defs/commit"},
        "resolved_commit": {"$ref": "#/$defs/commit"},
        "read_only_expected": {"const": true}
      }
    },
    "packetFile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "size_bytes", "role"],
      "properties": {
        "path": {
          "allOf": [
            {"$ref": "#/$defs/packetPath"},
            {"not": {"const": "PACKET_MANIFEST.json"}}
          ]
        },
        "sha256": {"$ref": "#/$defs/sha256"},
        "size_bytes": {"type": "integer", "minimum": 0},
        "role": {"$ref": "#/$defs/role"}
      }
    }
  }
}
