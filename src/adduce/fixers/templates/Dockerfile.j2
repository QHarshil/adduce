# [AUTHOR REVIEW REQUIRED] Draft runtime environment; verify the Python base,
# dependency installation, system packages, entrypoint, and hardware runtime.
# Pin the base image digest before publishing:
#   docker pull python:{{ python_version }}-slim && docker inspect --format='{{ '{{' }}index .RepoDigests 0{{ '}}' }}' python:{{ python_version }}-slim
FROM python:{{ python_version }}-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONHASHSEED=0 \
    CUBLAS_WORKSPACE_CONFIG=:4096:8

WORKDIR /workspace

{% if requirements_file %}COPY {{ requirements_file }} ./
RUN pip install --no-cache-dir -r {{ requirements_file }}
{% else %}# Declare dependencies in requirements.txt or pyproject.toml, then install them here.
{% endif %}
COPY . .

# [AUTHOR REVIEW REQUIRED] Replace with the exact main-results command.
CMD ["python", {{ entrypoint|tojson }}]
